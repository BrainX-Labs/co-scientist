{
  "mcpServers": {
    "e2b-sandbox": {
      "command": "npx",
      "args": ["-y", "@e2b/mcp-server"],
      "lifecycle": "eager",
      "env": {
        "E2B_API_KEY": "${E2B_API_KEY}"
      }
    },
    "paper-search": {
      "command": "python",
      "args": ["-m", "paper_search_mcp.server"],
      "lifecycle": "eager"
    },
    "tavily-search": {
      "command": "npx",
      "args": ["-y", "tavily-mcp"],
      "lifecycle": "eager",
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "lifecycle": "eager",
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "lean-prover": {
      "command": "uvx",
      "args": ["lean-lsp-mcp"],
      "lifecycle": "eager",
      "env": {
        "LEAN_PROJECT_PATH": "${PWD}/lean4_workspace"
      }
    }
  }
}
