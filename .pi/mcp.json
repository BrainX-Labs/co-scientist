{
  "mcpServers": {
    "e2b-sandbox": {
      "command": "npx",
      "args": ["-y", "@e2b/mcp-server"],
      "env": {
        "E2B_API_KEY": "${E2B_API_KEY}"
      }
    },
    "arxiv": {
      "command": "npx",
      "args": ["-y", "@tejas242/arxiv-mcp"]
    },
    "tavily-search": {
      "command": "npx",
      "args": ["-y", "tavily-mcp"],
      "env": {
        "TAVILY_API_KEY": "${TAVILY_API_KEY}"
      }
    },
    "brave-search": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-brave-search"],
      "env": {
        "BRAVE_API_KEY": "${BRAVE_API_KEY}"
      }
    },
    "lean-prover": {
      "command": "lean-mcp-server",
      "env": {
        "LEAN_PROJECT_PATH": "${PWD}/lean4_workspace"
      }
    }
  }
}
