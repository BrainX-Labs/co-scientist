{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "http://127.0.0.1:4000/v1"
      },
      "models": {
        "kimi-k3": {
          "name": "Kimi K3 via NVIDIA NIM"
        }
      }
    }
  },
  "mcp": {
    "tavily-search": {
      "type": "local",
      "command": ["npx", "-y", "tavily-mcp"],
      "environment": {
        "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
      },
      "enabled": true
    }
  }
}
